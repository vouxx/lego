# 설정 방법: docs/setup-github.md

# Supabase (zeek/wbs 프로젝트를 다른 앱과 공유, 테이블은 lego 스키마)
NEXT_PUBLIC_SUPABASE_URL=https://kqspyogrfebnlitqchvd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용 — NEXT_PUBLIC_ 접두사 금지
SUPABASE_SECRET_KEY=

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# .pem 내용을 한 줄로 (줄바꿈은 \n)
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
# 워커 엔드포인트(/api/scan-worker) 호출용. pg_cron 이 Bearer 로 보낸다.
SCAN_WORKER_SECRET=

# Sentry (선택). DSN 이 없으면 에러를 보내지 않는다.
NEXT_PUBLIC_SENTRY_DSN=
# 배포 빌드에서 소스맵 업로드용
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
