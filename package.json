{
  "name": "lego",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:types": "supabase gen types typescript --linked --schema lego > src/lib/supabase/database.types.ts",
    "db:migrate": "scripts/db-migrate.sh",
    "e2e": "playwright test",
    "e2e:login": "tsx tests/e2e/save-auth.mts",
    "e2e:local-seed": "tsx --env-file=.env.local tests/e2e/local-seed.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@base-ui/react": "^1.9.0",
    "@lego/scanner": "workspace:*",
    "@octokit/app": "^16.1.4",
    "@octokit/oauth-methods": "^6.0.5",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks-methods": "^6.0.0",
    "@sentry/nextjs": "^11.10.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.66.0",
    "mermaid": "^12.2.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^7.30.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
